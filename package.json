{
  "name": "pillout",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"@pillout/*\" run dev",
    "dev:web": "pnpm --filter @pillout/web run dev",
    "dev:api": "pnpm --filter @pillout/api run dev",
    "build": "pnpm -r run build",
    "preview": "pnpm --filter @pillout/web run preview",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck",
    "format": "oxfmt . && pnpm --filter @pillout/api run format",
    "format:check": "oxfmt --check . && pnpm --filter @pillout/api run format:check",
    "lint": "oxlint --max-warnings 0 . && pnpm --filter @pillout/api run lint",
    "lint:fix": "oxlint --fix --max-warnings 0 . && pnpm --filter @pillout/api run lint:fix"
  },
  "devDependencies": {
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0"
  }
}
