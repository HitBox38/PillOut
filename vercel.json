{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "vite",
      "installCommand": "corepack pnpm install --frozen-lockfile",
      "buildCommand": "corepack pnpm run build",
      "outputDirectory": "dist",
      "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
    },
    "api": {
      "root": "apps/api",
      "framework": "fastapi",
      "entrypoint": "src.pillout_api.main:app",
      "installCommand": "uv sync --locked --no-dev --no-install-project",
      "buildCommand": "python -c \"from src.pillout_api.main import app\"",
      "functions": {
        "src/pillout_api/main.py": {
          "includeFiles": "schema.sql",
          "excludeFiles": "{tests/**,.env,.env.*,dist/**}"
        }
      }
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": { "service": "api" } },
    { "source": "/docs/:path*", "destination": { "service": "api" } },
    { "source": "/redoc/:path*", "destination": { "service": "api" } },
    { "source": "/openapi.json", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
